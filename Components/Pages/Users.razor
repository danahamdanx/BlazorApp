@page "/users"
@using Radzen
@using Radzen.Blazor
@inject UserService UserService

<PageTitle>Users Management</PageTitle>
<RadzenCard Class="shadow-xl p-8 rounded-2xl bg-gradient-to-br from-white to-gray-50 border border-gray-200">
    <div class="mb-8">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h2 class="text-3xl font-extrabold text-gray-900 bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent">
                    Users Management
                </h2>
                <p class="text-gray-500 mt-1">Manage and monitor all system users</p>
            </div>
            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@($"Total: {totalCount} users")" Class="px-4 py-2 text-sm font-semibold" />
        </div>

        <!-- Enhanced Filters -->
        <RadzenTemplateForm Data="@filters" Class="bg-white p-6 rounded-2xl shadow-lg border border-gray-200">
            <div class="grid grid-cols-1 md:grid-cols-4 lg:grid-cols-5 gap-6 items-end">
                <div class="mb-4">
                    <label class="block text-sm font-semibold text-gray-700 mb-2">🔍 Name/Fullname</label>
                    <RadzenTextBox @bind-Value="@filters.NameFilter" Placeholder="Search users..." 
                                 Style="width:100%; border-radius:10px; padding:10px;"
                                 Class="border-2 border-gray-200 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200" />
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-semibold text-gray-700 mb-2">💰 Balance</label>
                    <div class="flex gap-2">
                        <RadzenDropDown @bind-Value="@filters.BalanceOperator" Data="@numericOperators"
                                      TextProperty="Text" ValueProperty="Value" Style="width:90px; border-radius:8px;" />
                        <RadzenNumeric @bind-Value="@filters.BalanceValue" Style="flex:1; border-radius:10px;" 
                                     Class="border-2 border-gray-200 focus:border-green-500" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-semibold text-gray-700 mb-2">💳 Debt</label>
                    <div class="flex gap-2">
                        <RadzenDropDown @bind-Value="@filters.DeptOperator" Data="@numericOperators"
                                      TextProperty="Text" ValueProperty="Value" Style="width:90px; border-radius:8px;" />
                        <RadzenNumeric @bind-Value="@filters.DeptValue" Style="flex:1; border-radius:10px;"
                                     Class="border-2 border-gray-200 focus:border-red-500" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-semibold text-gray-700 mb-2">🏪 Reseller</label>
                    <RadzenDropDown @bind-Value="@filters.ResellerId" Data="@resellers"
                                    TextProperty="Fullname" ValueProperty="UserId"
                                    Placeholder="Select Reseller" AllowClear="true" 
                                    Style="width:100%; border-radius:10px;"
                                    Class="border-2 border-gray-200 focus:border-yellow-500" />
                </div>
            </div>

            <!-- Buttons -->
            <div class="flex items-center gap-4 mt-6 mb-6">
                <RadzenButton Text="Apply" Icon="search" Click="@ApplyFilters" 
                              Class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 transition-all duration-200 font-semibold shadow-lg hover:shadow-xl" />
                <RadzenButton Text="Clear" Click="@ClearFilters" ButtonStyle="ButtonStyle.Light" Icon="clear_all" 
                              Class="px-6 py-2.5 rounded-xl hover:shadow-md transition-all duration-200 font-semibold" />
            </div>

        </RadzenTemplateForm>
    </div>

    <!-- Enhanced Data Grid -->
    <RadzenDataGrid TItem="User" Data="@filteredUsers" ColumnWidth="150px"
                    PageSize="@pageSize" AllowPaging="true" AllowSorting="true" AllowColumnResize="true"
                    Count="@totalCount" PageSizeOptions="@(new int[] { 5, 10, 20, 50 })" 
                    ShowPagingSummary="true" Class="rounded-2xl shadow-lg border-0 overflow-hidden">

        <Columns>
            <RadzenDataGridColumn TItem="User" Property="UserId" Title="🆔 User ID" Width="100px" />
            <RadzenDataGridColumn TItem="User" Property="Name" Title="👤 Username" Width="120px" />
            <RadzenDataGridColumn TItem="User" Property="Fullname" Title="📛 Full Name" Width="150px" />

            <RadzenDataGridColumn TItem="User" Property="Balance" Title="💰 Balance" Width="120px">
                <Template Context="user">
                    <span class="@GetBalanceClass(user.Balance) font-semibold px-2 py-1 rounded-lg bg-opacity-10 @(user.Balance >= 500 ? "bg-green-100 text-green-800" : "bg-yellow-100 text-yellow-800")">
                        @user.Balance.ToString("N2")
                    </span>
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="User" Property="Dept" Title="💳 Debt" Width="120px">
                <Template Context="user">
                    <span class="@GetDeptClass(user.Dept) font-semibold px-2 py-1 rounded-lg bg-opacity-10 @(user.Dept >= 1000 ? "bg-red-100 text-red-800" : "bg-blue-100 text-blue-800")">
                        @user.Dept.ToString("N2")
                    </span>
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="User" Title="📊 Net Position" Width="140px">
                <Template Context="user">
                    @{
                        var diff = user.Dept - user.Balance;
                        <span class="@GetDiffClass(diff) font-semibold px-2 py-1 rounded-lg bg-opacity-10 @(diff >= 0 ? "bg-red-100 text-red-800" : "bg-green-100 text-green-800")">
                            @diff.ToString("N2")
                        </span>
                    }
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="User" Property="UserType" Title="🎯 Role" Width="120px">
                <Template Context="user">
                    <RadzenBadge BadgeStyle="@GetRoleBadgeStyle(user.UserType)" 
                               Text="@user.UserType" Class="font-semibold" />
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="User" Property="CreatedDate" Title="📅 Created" Width="120px" />

            <RadzenDataGridColumn TItem="User" Title="🟢 Status" Width="100px">
                <Template Context="user">
                    <RadzenBadge BadgeStyle="@(user.Balance > 0 ? BadgeStyle.Success : BadgeStyle.Danger)"
                               Text="@(user.Balance > 0 ? "Active" : "Inactive")" 
                               Class="font-semibold shadow-sm" />
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="User" Title="⚡ Actions" Width="180px" Sortable="false" Filterable="false">
                <Template Context="user">
                    <div class="flex gap-2 justify-center">
                        <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                                    Click="@(() => EditUser(user))" 
                                    Class="rounded-lg hover:shadow-md transition-all duration-200"
                                    Tooltip="Edit User" />
                        <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger"
                                    Click="@(() => DeleteUser(user))" 
                                    Class="rounded-lg hover:shadow-md transition-all duration-200"
                                    Tooltip="Delete User" />
                        <RadzenButton Icon="visibility" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Info"
                                    Click="@(() => ViewUser(user))" 
                                    Class="rounded-lg hover:shadow-md transition-all duration-200"
                                    Tooltip="View Details" />
                    </div>
                </Template>
            </RadzenDataGridColumn>
        </Columns>

        <EmptyTemplate>
            <div class="text-center py-12 text-gray-500">
                <div class="inline-flex items-center justify-center w-16 h-16 bg-gray-100 rounded-full mb-4">
                    <RadzenIcon Icon="search_off" Style="font-size: 32px;" />
                </div>
                <p class="text-lg font-semibold text-gray-700">No users found</p>
                <p class="text-gray-500">Try adjusting your search criteria</p>
            </div>
        </EmptyTemplate>
    </RadzenDataGrid>
</RadzenCard>

@code {
    [Inject] IJSRuntime JSRuntime { get; set; }
    [Inject] NavigationManager NavigationManager { get; set; }
    [Inject] DialogService DialogService { get; set; }
    [Inject] TooltipService TooltipService { get; set; }
    [Inject] ContextMenuService ContextMenuService { get; set; }
    [Inject] NotificationService NotificationService { get; set; }

    private List<User> filteredUsers = new();
    private List<User> resellers = new();

    private int totalCount = 0;
    private int pageSize = 10;

    private class TempFilter
    {
        public string NameFilter { get; set; }
        public int? ResellerId { get; set; }
        public string BalanceOperator { get; set; } = "greater";
        public decimal? BalanceValue { get; set; }
        public string DeptOperator { get; set; } = "greater";
        public decimal? DeptValue { get; set; }
    }

    private TempFilter filters = new();

    private List<dynamic> numericOperators = new()
    {
        new { Text = "=", Value = "equal" },
        new { Text = "<", Value = "less" },
        new { Text = ">", Value = "greater" },
        new { Text = "≤", Value = "lessEqual" },
        new { Text = "≥", Value = "greaterEqual" }
    };

    protected override void OnInitialized()
    {
        LoadData();
        ApplyFilters();
    }

    private void LoadData()
    {
        var allUsers = UserService.GetAllUsers();
        resellers = UserService.GetResellers();
        totalCount = allUsers.Count;
        filteredUsers = allUsers;
    }

    private void ApplyFilters()
    {
        var query = UserService.GetAllUsers().AsEnumerable();

        if (!string.IsNullOrWhiteSpace(filters.NameFilter))
        {
            query = query.Where(u =>
                (u.Name?.Contains(filters.NameFilter, StringComparison.OrdinalIgnoreCase) == true) ||
                (u.Fullname?.Contains(filters.NameFilter, StringComparison.OrdinalIgnoreCase) == true));
        }

        if (filters.ResellerId.HasValue)
        {
            query = query.Where(u => u.UserId == filters.ResellerId.Value);
        }

        if (filters.BalanceValue.HasValue)
        {
            query = filters.BalanceOperator switch
            {
                "equal" => query.Where(u => u.Balance == filters.BalanceValue.Value),
                "less" => query.Where(u => u.Balance < filters.BalanceValue.Value),
                "greater" => query.Where(u => u.Balance > filters.BalanceValue.Value),
                "lessEqual" => query.Where(u => u.Balance <= filters.BalanceValue.Value),
                "greaterEqual" => query.Where(u => u.Balance >= filters.BalanceValue.Value),
                _ => query
            };
        }

        if (filters.DeptValue.HasValue)
        {
            query = filters.DeptOperator switch
            {
                "equal" => query.Where(u => u.Dept == filters.DeptValue.Value),
                "less" => query.Where(u => u.Dept < filters.DeptValue.Value),
                "greater" => query.Where(u => u.Dept > filters.DeptValue.Value),
                "lessEqual" => query.Where(u => u.Dept <= filters.DeptValue.Value),
                "greaterEqual" => query.Where(u => u.Dept >= filters.DeptValue.Value),
                _ => query
            };
        }

        filteredUsers = query.ToList();
        totalCount = filteredUsers.Count;
        StateHasChanged();
    }

    private void ClearFilters()
    {
        filters = new TempFilter();
        ApplyFilters();
    }

    private void EditUser(User user)
    {
        NavigationManager.NavigateTo($"/edit-user/{user.UserId}");
    }

   private async void DeleteUser(User user)
{
    var result = await DialogService.Confirm($"Are you sure you want to delete {user.Fullname}?", "Delete User",
        new ConfirmOptions() { 
            OkButtonText = "Yes, Delete", 
            CancelButtonText = "Cancel"
        });

    if (result == true)
    {
        UserService.DeleteUser(user.UserId);
        ApplyFilters();
        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Success,
            Summary = "Deleted!",
            Detail = $"{user.Fullname} has been removed successfully",
            Duration = 3000
        });
    }
}

    private void ViewUser(User user)
    {
        NavigationManager.NavigateTo($"/view-user/{user.UserId}");
    }

    private BadgeStyle GetRoleBadgeStyle(string userType)
    {
        return userType?.ToLower() switch
        {
            "admin" => BadgeStyle.Danger,
            "reseller" => BadgeStyle.Warning,
            "customer" => BadgeStyle.Info,
            _ => BadgeStyle.Secondary
        };
    }

    private string GetBalanceClass(decimal balance) => balance >= 500 ? "text-success" : "text-warning";
    private string GetDeptClass(decimal dept) => dept >= 1000 ? "text-danger" : "text-info";
    private string GetDiffClass(decimal diff) => diff >= 0 ? "text-danger" : "text-success";
}