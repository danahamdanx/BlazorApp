@page "/edit-user/{UserId:int}"
@using Radzen
@using Radzen.Blazor
@inject UserService UserService

<PageTitle>Edit User</PageTitle>

<RadzenCard Class="shadow-2xl p-8 rounded-2xl bg-gradient-to-br from-white to-gray-50 border border-gray-200">
    <div class="flex justify-between items-center mb-8">
        <div>
            <h2 class="text-3xl font-extrabold text-gray-900 bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent">
                Edit User
            </h2>
            <p class="text-gray-500 mt-1">Update user information and financial details</p>
        </div>
        <RadzenButton Icon="arrow_back" Text="Back to Users" Click="@GoBack" 
                      ButtonStyle="ButtonStyle.Secondary" Class="px-6 py-3 rounded-lg hover:shadow-md transition-all duration-200" />
    </div>

    @if (user != null)
    {
        <RadzenTemplateForm TItem="User" Data="@user" Submit="@SaveUser" Class="space-y-6">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <!-- Basic Information Card -->
                <RadzenCard Class="p-8 rounded-2xl shadow-lg border-0 bg-white hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
                    <div class="flex items-center mb-6">
                        <RadzenIcon Icon="person" Class="text-indigo-600 mr-3 text-2xl" />
                        <h3 class="text-xl font-bold text-gray-800">Basic Information</h3>
                    </div>
                    <div class="space-y-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                                <RadzenIcon Icon="badge" Class="text-indigo-500 mr-2" />
                                Username
                            </label>
                            <RadzenTextBox @bind-Value="@user.Name" Placeholder="Enter username" 
                                         Style="width:100%; border-radius:12px; padding:12px; border:2px solid #e5e7eb;"
                                         Class="focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition-all duration-200" />
                        </div>
                        
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                                <RadzenIcon Icon="account_circle" Class="text-indigo-500 mr-2" />
                                Full Name
                            </label>
                            <RadzenTextBox @bind-Value="@user.Fullname" Placeholder="Enter full name" 
                                         Style="width:100%; border-radius:12px; padding:12px; border:2px solid #e5e7eb;"
                                         Class="focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition-all duration-200" />
                        </div>
                        
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                                <RadzenIcon Icon="phone" Class="text-indigo-500 mr-2" />
                                Phone Number
                            </label>
                            <RadzenTextBox @bind-Value="@user.UserPhone" Placeholder="Enter phone number" 
                                         Style="width:100%; border-radius:12px; padding:12px; border:2px solid #e5e7eb;"
                                         Class="focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition-all duration-200" />
                        </div>
                        
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                                <RadzenIcon Icon="admin_panel_settings" Class="text-indigo-500 mr-2" />
                                User Role
                            </label>
                            <RadzenDropDown @bind-Value="@user.UserType" Data="@userTypes"
                                          TextProperty="Text" ValueProperty="Value" Placeholder="Select role" 
                                          Style="width:100%; border-radius:12px; padding:8px; border:2px solid #e5e7eb;"
                                          Class="focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition-all duration-200" />
                        </div>
                    </div>
                </RadzenCard>

                <!-- Financial Information Card -->
                <RadzenCard Class="p-8 rounded-2xl shadow-lg border-0 bg-gradient-to-br from-green-50 to-emerald-50 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
                    <div class="flex items-center mb-6">
                        <RadzenIcon Icon="account_balance_wallet" Class="text-green-600 mr-3 text-2xl" />
                        <h3 class="text-xl font-bold text-gray-800">Financial Information</h3>
                    </div>
                    <div class="space-y-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                                <RadzenIcon Icon="payments" Class="text-green-500 mr-2" />
                                Balance
                                <span class="ml-2 text-xs bg-green-100 text-green-800 px-2 py-1 rounded-full">Available</span>
                            </label>
                            <RadzenNumeric @bind-Value="@user.Balance" Format="N2" Placeholder="0.00" 
                                         Style="width:100%; border-radius:12px; padding:12px; border:2px solid #e5e7eb;"
                                         Class="focus:border-green-500 focus:ring-2 focus:ring-green-200 transition-all duration-200" />
                        </div>
                        
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                                <RadzenIcon Icon="savings" Class="text-green-500 mr-2" />
                                Cash
                                <span class="ml-2 text-xs bg-blue-100 text-blue-800 px-2 py-1 rounded-full">Physical</span>
                            </label>
                            <RadzenNumeric @bind-Value="@user.Cash" Format="N2" Placeholder="0.00" 
                                         Style="width:100%; border-radius:12px; padding:12px; border:2px solid #e5e7eb;"
                                         Class="focus:border-green-500 focus:ring-2 focus:ring-green-200 transition-all duration-200" />
                        </div>
                        
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                                <RadzenIcon Icon="money_off" Class="text-red-500 mr-2" />
                                Debt
                                <span class="ml-2 text-xs bg-red-100 text-red-800 px-2 py-1 rounded-full">Owed</span>
                            </label>
                            <RadzenNumeric @bind-Value="@user.Dept" Format="N2" Placeholder="0.00" 
                                         Style="width:100%; border-radius:12px; padding:12px; border:2px solid #e5e7eb;"
                                         Class="focus:border-red-500 focus:ring-2 focus:ring-red-200 transition-all duration-200" />
                        </div>
                        
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                                <RadzenIcon Icon="category" Class="text-purple-500 mr-2" />
                                User Category
                            </label>
                            <RadzenTextBox @bind-Value="@user.UserCategory" Placeholder="Enter category" 
                                         Style="width:100%; border-radius:12px; padding:12px; border:2px solid #e5e7eb;"
                                         Class="focus:border-purple-500 focus:ring-2 focus:ring-purple-200 transition-all duration-200" />
                        </div>
                    </div>
                </RadzenCard>
            </div>

            <!-- Enhanced Action Buttons -->
            <div class="flex justify-end gap-4 mt-8 pt-6 border-t border-gray-200">
                <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Secondary" Click="@GoBack" 
                              Class="px-8 py-3 rounded-xl hover:shadow-lg transition-all duration-200 font-semibold" />
                <RadzenButton Text="Save Changes" Icon="save" ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit" 
                              Class="px-8 py-3 rounded-xl bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 shadow-lg hover:shadow-xl transition-all duration-200 transform hover:-translate-y-0.5 font-semibold" />
            </div>
        </RadzenTemplateForm>
    }
    else
    {
        <div class="text-center py-16 text-gray-500">
            <div class="inline-flex items-center justify-center w-20 h-20 bg-red-100 rounded-full mb-6">
                <RadzenIcon Icon="person_off" Style="font-size:40px; color:#ef4444;" />
            </div>
            <p class="text-xl font-semibold text-gray-700 mb-2">User Not Found</p>
            <p class="text-gray-500 mb-6">The user you're looking for doesn't exist or has been removed.</p>
            <RadzenButton Text="Back to Users" Icon="arrow_back" Click="@GoBack" 
                          ButtonStyle="ButtonStyle.Secondary" Class="px-6 py-3 rounded-lg hover:shadow-md transition-all duration-200" />
        </div>
    }
</RadzenCard>

@code {
    [Parameter] public int UserId { get; set; }
    [Inject] NavigationManager NavigationManager { get; set; }
    [Inject] NotificationService NotificationService { get; set; }

    private User user;

    private List<dynamic> userTypes = new()
    {
        new { Text = "👤 Customer", Value = "Customer" },
        new { Text = "🏪 Reseller", Value = "Reseller" },
        new { Text = "⚡ Admin", Value = "Admin" }
    };

    protected override void OnInitialized()
    {
        LoadUserData();
    }

    protected override void OnParametersSet()
    {
        LoadUserData();
    }

    private void LoadUserData()
    {
        user = UserService.GetUserById(UserId);
    }

   private void SaveUser()
{
    try
    {
        UserService.UpdateUser(user);
        
        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Success,
            Summary = "Success!",
            Detail = $"{user.Fullname} has been updated successfully",
            Duration = 4000
        });

        NavigationManager.NavigateTo("/users");
    }
    catch (Exception ex)
    {
        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Error,
            Summary = "Error",
            Detail = $"Failed to update user: {ex.Message}",
            Duration = 5000
        });
    }
}

    private void GoBack()
    {
        NavigationManager.NavigateTo("/users");
    }
}